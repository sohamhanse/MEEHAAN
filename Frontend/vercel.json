{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "meehaan.com" }],
      "destination": "https://www.meehaan.com/$1",
      "permanent": true
    },
    { "source": "/products", "destination": "/solutions/industrial", "permanent": true },
    { "source": "/products/oils", "destination": "/solutions/industrial/oils", "permanent": true },
    { "source": "/products/connectors", "destination": "/solutions/industrial/connectors", "permanent": true },
    { "source": "/products/oils/:categoryId", "destination": "/solutions/industrial/oils/:categoryId", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/solutions/industrial/battery/:sub/:product",
      "destination": "/solutions/industrial/battery/:sub"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
